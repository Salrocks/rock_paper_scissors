"""
Rock, Paper, Scissors
----------------------
A simple command-line game where the user plays against the computer.
The computer's choice is randomized, the user's choice is taken via input(),
and the winner is determined using standard rock-paper-scissors rules.

Author: Sal
"""

import random

# ASCII art for each possible choice, used to visually display the result
rock = '''
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
'''

paper = '''
    _______
---'   ____)____
          ______)
          _______)
         _______)
---.__________)
'''

scissors = '''
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
'''

# Maps each index (0, 1, 2) to its corresponding choice name.
# This lets us use a single number to represent rock/paper/scissors
# throughout the rest of the program, instead of comparing strings.
action_list = ["rock", "paper", "scissors"]

# Computer randomly picks an index between 0 and 2 (inclusive)
computer_choice = random.randint(0, 2)

# Prompt the user for their choice and convert it from a string to an int,
# since input() always returns a string by default
user_choice = int(input("Please pick a number from 0 to 2. 0 - Rock, 1 - Paper, 2 - Scissors: "))

# --- Display the user's choice ---
if user_choice == 0:
    print(f"The user chose: {action_list[user_choice]} ")
    print(rock)
elif user_choice == 1:
    print(f"The user chose: {action_list[user_choice]} ")
    print(paper)
elif user_choice == 2:
    print(f"The user chose: {action_list[user_choice]} ")
    print(scissors)
else:
    # Exit immediately if the input is not a valid choice (0, 1, or 2)
    exit()

# --- Display the computer's choice ---
if computer_choice == 0:
    print(f"The computer chose: {action_list[computer_choice]} ")
    print(rock)
elif computer_choice == 1:
    print(f"The computer chose: {action_list[computer_choice]} ")
    print(paper)
elif computer_choice == 2:
    print(f"The computer chose: {action_list[computer_choice]} ")
    print(scissors)
else:
    exit()

# --- Determine the winner ---
# Standard rock-paper-scissors rules:
#   Rock (0) beats Scissors (2)
#   Paper (1) beats Rock (0)
#   Scissors (2) beats Paper (1)
if user_choice == computer_choice:
    print("Its a draw")
elif computer_choice == 0 and user_choice == 2:
    print("The computer won")
elif computer_choice == 1 and user_choice == 0:
    print("The computer won")
elif computer_choice == 2 and user_choice == 1:
    print("The computer won")
else:
    print("The user won")
